---
import site from '@/content/site.it.json';
import Icon from '@/components/Icon.astro';
const f = site.faq;
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: f.items.map((i) => ({
    '@type': 'Question',
    name: i.q,
    acceptedAnswer: { '@type': 'Answer', text: i.a },
  })),
};
---

<section id="faq" class="section scroll-mt-20 bg-slate-50" aria-labelledby="faq-title">
  <div class="container-content grid gap-10 lg:grid-cols-[1fr_2fr]">
    <div data-reveal>
      <p class="eyebrow">{f.eyebrow}</p>
      <h2 id="faq-title" class="mt-4 text-h2">{f.title}</h2>
    </div>
    <div class="divide-y divide-slate-200 rounded-card border border-slate-200 bg-white" data-reveal>
      {
        f.items.map((item) => (
          <details class="faq-item group" name="faq">
            <summary class="flex min-h-14 cursor-pointer items-center justify-between gap-4 px-5 py-4 text-left font-semibold text-navy-900 hover:bg-slate-50 lg:px-6">
              <span>{item.q}</span>
              <Icon name="chevron-down" class="chevron h-5 w-5 shrink-0 text-slate-600" />
            </summary>
            <div class="px-5 pb-5 text-[0.9375rem] text-slate-600 lg:px-6">
              <p>{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
<script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
