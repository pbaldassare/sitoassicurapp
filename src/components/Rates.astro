---
import site from '@/content/site.it.json';
import Icon from '@/components/Icon.astro';
const r = site.rates;
const tiles = [
  ...r.base.map((name) => ({ name, type: 'base' as const })),
  ...r.convention.map((name) => ({ name, type: 'convention' as const })),
];
const total = tiles.length;
---

<section id="tariffe" class="section scroll-mt-20 bg-slate-50" aria-labelledby="rates-title">
  <div class="container-content">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">{r.eyebrow}</p>
        <h2 id="rates-title" class="mt-4 text-h2 lg:text-[2.5rem] lg:leading-[3rem]">{r.title}</h2>
        <p class="mt-4 text-slate-600">{r.intro}</p>
      </div>

      <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filtra le tariffe" data-reveal data-rates-filters>
        {
          r.filters.map((filter, i) => (
            <button
              type="button"
              class:list={[
                'inline-flex min-h-11 items-center rounded-pill border px-4 text-[0.9375rem] font-semibold transition-colors',
                'aria-pressed:bg-navy-700 aria-pressed:text-white aria-pressed:border-navy-700',
                'border-slate-200 bg-white text-navy-900 hover:border-navy-700',
              ]}
              aria-pressed={i === 0 ? 'true' : 'false'}
              data-filter={filter.id}
            >
              {filter.label}
            </button>
          ))
        }
        <p class="ml-2 text-small text-slate-600" aria-live="polite" data-rates-count>
          {r.countLabel.replace('{n}', String(total))}
        </p>
      </div>
    </div>

    <ul class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5" data-rates-grid>
      {
        tiles.map((t, i) => (
          <li
            class:list={[
              'card card-glow relative flex min-h-24 flex-col justify-between p-4',
              t.type === 'convention' && 'border-dashed bg-slate-50/60',
            ]}
            data-type={t.type}
            data-reveal
            style={`--reveal-delay: ${(i % 5) * 50}ms`}
          >
            <span class="text-[1.0625rem] leading-snug font-bold tracking-tight text-navy-900">{t.name}</span>
            <span class="mt-3 flex items-center gap-1.5 text-[0.75rem] font-semibold">
              {t.type === 'convention' ? (
                <>
                  <Icon name="handshake" class="h-3.5 w-3.5 text-navy-700" />
                  <span class="text-navy-700">{r.conventionLabel}</span>
                </>
              ) : (
                <>
                  <span class="dot-live h-1.5 w-1.5 rounded-full bg-green-500" aria-hidden="true" />
                  <span class="text-slate-600">{r.baseLabel}</span>
                </>
              )}
            </span>
          </li>
        ))
      }
    </ul>

    <div class="mt-8 flex items-start gap-3 rounded-card border border-slate-200 bg-white p-5" data-reveal>
      <span class="icon-chip !h-10 !w-10"><Icon name="lock" class="h-5 w-5" /></span>
      <div>
        <p class="font-semibold text-navy-900">{r.note}</p>
        <p class="mt-1 text-small text-slate-600">{r.disclaimer}</p>
      </div>
    </div>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-rates-filters] [data-filter]');
  const tiles = document.querySelectorAll<HTMLElement>('[data-rates-grid] [data-type]');
  const count = document.querySelector<HTMLElement>('[data-rates-count]');
  const label = count?.textContent?.trim().replace(/^\d+/, '{n}') ?? '{n}';
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const id = btn.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      let n = 0;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      tiles.forEach((t, i) => {
        const show = id === 'all' || t.dataset.type === id;
        if (show) n++;
        if (reduce) {
          t.hidden = !show;
          return;
        }
        if (!show) {
          t.classList.add('is-leaving');
          setTimeout(() => {
            t.hidden = true;
          }, 250);
        } else {
          t.hidden = false;
          t.classList.add('is-leaving');
          // rientro con leggero stagger
          setTimeout(() => t.classList.remove('is-leaving'), 20 + (i % 10) * 25);
        }
      });
      if (count) count.textContent = label.replace('{n}', String(n));
    })
  );
</script>
