---
// Font self-hosted: niente CSS bloccante né connessioni a Google (prestazioni e GDPR)
import '@fontsource/plus-jakarta-sans/latin-400.css';
import '@fontsource/plus-jakarta-sans/latin-500.css';
import '@fontsource/plus-jakarta-sans/latin-600.css';
import '@fontsource/plus-jakarta-sans/latin-700.css';
import font700 from '@fontsource/plus-jakarta-sans/files/plus-jakarta-sans-latin-700-normal.woff2?url';
import '@/styles/global.css';
import site from '@/content/site.it.json';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Pagina "leggera" (privacy, grazie): header compatto, nessun JSON-LD SoftwareApplication */
  minimal?: boolean;
  noindex?: boolean;
}
const { title = site.meta.title, description = site.meta.description, minimal = false, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/brand/og-image.png', Astro.site);
const org = site.organization;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.meta.siteName,
    legalName: org.legalName,
    url: Astro.site?.toString(),
    logo: new URL('/brand/logo.svg', Astro.site).toString(),
    email: org.email,
    telephone: org.telephone,
  },
  ...(minimal
    ? []
    : [
        {
          '@context': 'https://schema.org',
          '@type': 'SoftwareApplication',
          name: site.meta.siteName,
          applicationCategory: 'BusinessApplication',
          operatingSystem: 'Web',
          description: site.meta.description,
          url: Astro.site?.toString(),
          image: ogImage.toString(),
          inLanguage: 'it',
          audience: { '@type': 'BusinessAudience', audienceType: 'Agenzie e broker assicurativi' },
          featureList: site.features.blocks.map((b) => b.title).join(', '),
          offers: { '@type': 'Offer', availability: 'https://schema.org/InStock', description: 'Demo su richiesta' },
          provider: { '@type': 'Organization', name: org.legalName },
        },
      ]),
];
---

<!doctype html>
<html lang="it" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0F172A" />
    <meta name="color-scheme" content="light" />

    <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/brand/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" sizes="180x180" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.meta.siteName} />
    <meta property="og:locale" content={site.meta.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.meta.siteName} — ${site.meta.claim}`} />
    <meta name="twitter:card" content={site.meta.twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" href={font700} as="font" type="font/woff2" crossorigin />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body class="min-h-dvh flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-pill focus:bg-navy-900 focus:px-4 focus:py-2 focus:text-white"
      >{site.nav.skipLink}</a
    >
    <div class="scroll-progress" aria-hidden="true" data-scroll-progress></div>
    <Header minimal={minimal} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      // Entrata soft delle sezioni (solo se motion consentita; CSS gestisce il resto)
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (reduce || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        els.forEach((el) => io.observe(el));
      }

      // Barra di avanzamento: fallback JS dove manca animation-timeline
      const bar = document.querySelector<HTMLElement>('[data-scroll-progress]');
      if (bar && !CSS.supports('animation-timeline: scroll()')) {
        const update = () => {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          bar.style.transform = `scaleX(${max > 0 ? Math.min(1, window.scrollY / max) : 0})`;
        };
        update();
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
      }

      // Contatori: i numeri salgono quando entrano in vista
      const counters = document.querySelectorAll<HTMLElement>('[data-count]');
      if (counters.length) {
        const run = (el: HTMLElement) => {
          const target = Number(el.dataset.count);
          if (reduce || !Number.isFinite(target)) {
            el.textContent = String(target);
            return;
          }
          const start = performance.now();
          const dur = 1100;
          const tick = (t: number) => {
            const p = Math.min(1, (t - start) / dur);
            const eased = 1 - Math.pow(1 - p, 3);
            el.textContent = String(Math.round(target * eased));
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        };
        const cio = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                run(e.target as HTMLElement);
                cio.unobserve(e.target);
              }
            }
          },
          { threshold: 0.4 }
        );
        counters.forEach((c) => cio.observe(c));
      }

      // Tilt 3D leggero sul mockup (solo pointer fine)
      const tilt = document.querySelector<HTMLElement>('.tilt');
      if (tilt && !reduce && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        const parent = tilt.parentElement ?? tilt;
        parent.addEventListener('pointermove', (e) => {
          const r = tilt.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width - 0.5;
          const y = (e.clientY - r.top) / r.height - 0.5;
          tilt.style.setProperty('--ry', `${(x * 8).toFixed(2)}deg`);
          tilt.style.setProperty('--rx', `${(-y * 8).toFixed(2)}deg`);
        });
        parent.addEventListener('pointerleave', () => {
          tilt.style.setProperty('--ry', '0deg');
          tilt.style.setProperty('--rx', '0deg');
        });
      }

      // Scroll-spy: evidenzia la voce di menu della sezione visibile
      const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav-link[href^="#"]'));
      const targets = links.map((l) => document.querySelector<HTMLElement>(l.getAttribute('href')!)).filter(Boolean) as HTMLElement[];
      if (targets.length && 'IntersectionObserver' in window) {
        const spy = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                links.forEach((l) => l.setAttribute('aria-current', l.getAttribute('href') === '#' + e.target.id ? 'true' : 'false'));
              }
            }
          },
          { rootMargin: '-40% 0px -55% 0px' }
        );
        targets.forEach((t) => spy.observe(t));
      }
    </script>
  </body>
</html>
