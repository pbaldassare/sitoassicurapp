---
import Base from '@/layouts/Base.astro';
---

<Base title="Pagina non trovata — Assicurapp" description="La pagina che cerchi non esiste." minimal noindex>
  <section class="section">
    <div class="container-content max-w-2xl text-center">
      <p class="eyebrow justify-center">Errore 404</p>
      <h1 class="mt-4 text-h1">Questa pagina non esiste.</h1>
      <p class="mt-4 text-slate-600">Forse il link è cambiato. Torna alla home e riparti da lì.</p>
      <a href="/" class="btn btn-primary mt-8">Torna al sito</a>
    </div>
  </section>
</Base>
