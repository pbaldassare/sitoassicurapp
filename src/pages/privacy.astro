---
import Base from '@/layouts/Base.astro';
import site from '@/content/site.it.json';
const p = site.privacy;
---

<Base title={p.metaTitle} description="Informativa sul trattamento dei dati personali per chi visita il sito e compila il modulo di contatto." minimal>
  <article class="section">
    <div class="container-content max-w-3xl">
      <p class="eyebrow">Legale</p>
      <h1 class="mt-4 text-h1">{p.title}</h1>
      <p class="mt-3 text-small text-slate-600">{p.updated}</p>
      <p class="mt-6 text-slate-600">{p.intro}</p>

      <nav aria-label="Indice" class="mt-8 rounded-card border border-slate-200 bg-slate-50 p-5">
        <ol class="grid gap-1.5 text-[0.9375rem] sm:grid-cols-2">
          {
            p.sections.map((s) => (
              <li>
                <a href={`#${s.id}`} class="inline-flex min-h-8 items-center text-navy-700 hover:underline">
                  {s.title}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      {
        p.sections.map((s) => (
          <section id={s.id} class="mt-10 scroll-mt-24">
            <h2 class="text-h3">{s.title}</h2>
            {s.paragraphs.map((t) => (
              <p class="mt-3 text-slate-600">{t}</p>
            ))}
          </section>
        ))
      }
    </div>
  </article>
</Base>
